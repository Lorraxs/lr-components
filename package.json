{
  "version": "0.7.5",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test --passWithNoTests",
    "lint": "tsdx lint",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "icon": "fantasticon icons/svg -o src/icons --normalize true"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/test/styleMock.ts",
      "^lottie-web$": "<rootDir>/test/lottieMock.ts"
    }
  },
  "name": "lr-components",
  "author": "Lorraxs",
  "module": "dist/lr-components.esm.js",
  "size-limit": [
    {
      "path": "dist/lr-components.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/lr-components.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^10.0.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-slider": "^1.3.4",
    "fantasticon": "^1.2.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "postcss": "^8.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "size-limit": "^10.0.2",
    "tsdx": "^0.14.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@uidotdev/usehooks": "^2.4.1",
    "autoprefixer": "^10.4.21",
    "csstype": "^3.1.3",
    "framer-motion": "^11.0.5",
    "lottie-web": "^5.12.2",
    "moment": "^2.29.4",
    "react-icons": "^4.11.0",
    "rollup-plugin-postcss": "^4.0.2",
    "styled-components": "^6.1.1",
    "usehooks-ts": "^2.9.1"
  }
}
